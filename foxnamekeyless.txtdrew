-- Smooth Shake Effect
local function SmoothShakeUI()
    local origPos = MainFrame.Position
    local shakeInfo = TweenInfo.new(0.04, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
    local offsets = {6, -6, 4, -4, 2, -2, 0}
    
    for _, offset in ipairs(offsets) do
        local tween = TweenService:Create(MainFrame, shakeInfo, {
            Position = origPos + UDim2.new(0, offset, 0, 0)
        })
        tween:Play()
        tween.Completed:Wait()
    end
end

-- Events
GetKeyBtn.MouseButton1Click:Connect(function()
    setclipboard(KeyLink)
    StatusLabel.TextColor3 = MainBlue
    StatusLabel.Text = "✔ Key link copied to clipboard!"
    task.wait(2)
    if StatusLabel.Text == "✔ Key link copied to clipboard!" then
        StatusLabel.Text = ""
    end
end)

SubmitBtn.MouseButton1Click:Connect(function()
    if KeyInput.Text == CorrectKey then
        SaveKey(KeyInput.Text)
        StatusLabel.TextColor3 = Color3.fromRGB(120, 255, 180)
        StatusLabel.Text = "✔ Correct Key! Loading Fox Name..."
        TweenService:Create(UIStroke, TweenInfoFast, {Color = Color3.fromRGB(120, 255, 180)}):Play()
        task.wait(1.2)
        ScreenGui:Destroy()
        
        LoadMainScript()
    else
        StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        StatusLabel.Text = "✖ Invalid Key! Please try again."
        TweenService:Create(KeyInputStroke, TweenInfoFast, {Color = Color3.fromRGB(255, 100, 100)}):Play()
        SmoothShakeUI()
        KeyInput.Text = ""
        task.wait(1.5)
        TweenService:Create(KeyInputStroke, TweenInfoFast, {Color = Color3.fromRGB(45, 60, 80)}):Play()
    end
end)
