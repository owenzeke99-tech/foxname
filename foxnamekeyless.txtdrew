local CorrectKey = "FoxNameAutoTxtLoader - CyprrkakoehGskkenejdnejdnd"
local KeyLink = "https://link4m.net/9Taf0n"
local KeyFileName = "FoxNameKeyData.json"
local ExpirationTime = 24 * 60 * 60 -- 24 hours in seconds

-- Services
local HttpService = game:GetService("HttpService")
local TweenService = game:GetService("TweenService")
local TweenInfoFast = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Function to execute main script
local function LoadMainScript()
    loadstring(game:HttpGet("https://raw.githubusercontent.com/caomod2077/Script/refs/heads/main/Fn-stealanegg.lua"))()
end

-- Save & Check Key System Function
local function SaveKey(key)
    if writefile then
        local data = {
            SavedKey = key,
            Timestamp = os.time()
        }
        writefile(KeyFileName, HttpService:JSONEncode(data))
    end
end

local function IsKeyValid()
    if isfile and isfile(KeyFileName) and readfile then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(KeyFileName))
        end)
        
        if success and result and result.SavedKey and result.Timestamp then
            if result.SavedKey == CorrectKey and (os.time() - result.Timestamp) < ExpirationTime then
                return true
            end
        end
    end
    return false
end

-- Auto-Login check
if IsKeyValid() then
    LoadMainScript()
    return
end

-- Color Palette (Light Cyan / Sky Blue Theme)
